# Vast.ai API key — required for provisioning instances
# Get it from https://vast.ai → Settings → API Keys
VAST_API_KEY=

# S3 checkpoint backup. Prefer an IAM role or short-lived credentials when possible.
S3_BUCKET=
S3_PREFIX=toy-pickplace/flywheel
AWS_REGION=us-east-1
# AWS_PROFILE=toy-pickplace-backup  # Preferred when credentials are in ~/.aws/credentials
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# S3_ENDPOINT_URL=  # Optional for S3-compatible services
